# Copy to .env and fill in the key locally. Never commit .env.
# ROBOT_LLM_API_KEY = 阿里百炼（DashScope）key，与语音 demo 同一把可复用。
ROBOT_LLM_API_KEY=
ROBOT_LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
ROBOT_LLM_MODEL=qwen3.8-flash

# 默认启用本机 Harness Agent（DeepSeek Harness 只是运行工具，模型渠道为百炼）。legacy 仅用于回退旧对话后端。
ROBOT_AGENT_BACKEND=harness
ROBOT_HARNESS_COMMAND=/usr/local/bin/dsh
ROBOT_HARNESS_TIMEOUT_SECONDS=60
ROBOT_HARNESS_MAX_TOKENS=700
# 常驻 Agent 进程：连续对话免冷启动（实测省 1.3~1.8 秒/轮）；空闲超过秒数自动回收。
ROBOT_HARNESS_IDLE_SECONDS=300
ROBOT_HARNESS_MAX_WARM=4

# 以下 LLM 参数用于 legacy；Harness 使用上面的参数，并关闭思考模式。
ROBOT_LLM_REASONING_EFFORT=
ROBOT_LLM_THINKING=disabled
ROBOT_LLM_MAX_TOKENS=160
ROBOT_LLM_TIMEOUT_SECONDS=12

# 语音识别：dashscope=服务端百炼 qwen3-asr-flash（录音上传识别，推荐）；browser=沿用浏览器 Web Speech。
ROBOT_STT_BACKEND=dashscope
ROBOT_STT_MODEL=qwen3-asr-flash

# 音色：bailian:Cherry=百炼云端（demo 实测首片 314~379ms，推荐）；zf_001=Kokoro 本地；
# argmax:* =Argmax 本地。auto：按所选音色走，失败自动回退本地神经语音→macOS 中文音色。
# kokoro：严格要求神经语音；system：仅用 macOS 音色。
ROBOT_TTS_BACKEND=auto
ROBOT_TTS_VOICE=bailian:Cherry
ROBOT_TTS_SPEED=1.0
ROBOT_TTS_SYSTEM_VOICE=Tingting
ROBOT_TTS_BAILIAN_MODEL=qwen3-tts-flash
ROBOT_TTS_BAILIAN_VOICE=Cherry
